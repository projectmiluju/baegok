# ── GitHub OAuth ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/github/callback

# ── Database (RDS) ──
DATABASE_URL=postgresql://baegok:PASSWORD@your-rds-endpoint:5432/baegok

# ── Redis (ElastiCache) ──
REDIS_URL=redis://your-elasticache-endpoint:6379

# ── Kafka (내부 Docker 네트워크) ──
KAFKA_BROKERS=kafka:9092

# ── AI ──
ANTHROPIC_API_KEY=

# ── JWT ──
JWT_SECRET=

# ── 세션 만료 (초, 기본 7일) ──
SESSION_MAX_AGE_SECONDS=604800

# ── Token 암호화 (openssl rand -hex 32) ──
TOKEN_ENCRYPTION_KEY=

# ── URL ──
WEB_BASE_URL=https://your-domain.com
WEBHOOK_BASE_URL=https://your-domain.com
AI_API_URL=http://ai:8000
NEXT_PUBLIC_API_URL=https://your-domain.com

# ── CORS ──
CORS_ORIGIN=https://your-domain.com

# ── Ports ──
PORT=4000
AI_PORT=8000

# ── Celery ──
CELERY_BROKER_URL=redis://your-elasticache-endpoint:6379/0
CELERY_RESULT_BACKEND=redis://your-elasticache-endpoint:6379/1
